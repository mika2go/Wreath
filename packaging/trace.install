post_install() {
  printf '%s\n' \
    'Trace installed.' \
    'Enable the recorder with: systemctl --user reenable --now traced.service' \
    'Hyprland shortcuts are registered automatically.' \
    'On KDE Plasma, assign your preferred shortcut to: tracectl save' \
    'Run `tracectl doctor` to verify capture, GPU, audio, and desktop integration.'
}

post_upgrade() {
  post_install
}
