[Desktop Entry]
Type=Application
Name=Wreath
GenericName=Game Clip Recorder
Comment=Capture and watch local instant replays
Exec=wreath-ui
TryExec=wreath-ui
Icon=io.github.mika2go.Wreath
Terminal=false
Categories=AudioVideo;Recorder;
Keywords=wreath;replay;recording;clip;video;hyprland;kde;plasma;
StartupNotify=true
StartupWMClass=io.github.mika2go.Wreath
Actions=SaveClip;

[Desktop Action SaveClip]
Name=Save replay now
Exec=wreathctl save
