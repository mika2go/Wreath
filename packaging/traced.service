[Unit]
Description=Trace instant replay daemon
Documentation=https://github.com/mika2go/trace
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/traced
# Hyprland is configured automatically. Other desktops receive manual shortcut guidance.
ExecStartPost=-/usr/bin/tracectl bind
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=mixed
UMask=0077
IPAddressDeny=any
# gpu-screen-recorder's capability-based KMS helper needs the host mount namespace.
LimitNOFILE=256

[Install]
WantedBy=graphical-session.target
