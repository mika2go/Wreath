pkgname=wreath-git
pkgver=0.2.1.r0.g0000000
pkgrel=1
pkgdesc="Lightweight local-first instant replay recorder for Linux desktops"
arch=('x86_64')
url="https://github.com/mika2go/wreath"
license=('MIT')
depends=(
  'ffmpeg'
  'gpu-screen-recorder'
  'gst-libav'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk4'
  'libnotify'
  'libpulse'
  'xdg-utils'
)
makedepends=('cargo' 'git')
optdepends=(
  'hyprland: automatic native replay shortcut and focused-monitor detection'
  'xdg-desktop-portal-hyprland: portal capture fallback on Hyprland'
  'xdg-desktop-portal-kde: portal capture fallback on KDE Plasma'
)
provides=('wreath')
conflicts=('wreath')
install=wreath.install
source=("$pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local description
  if description="$(git describe --long --tags 2>/dev/null)"; then
    printf '%s\n' "$description" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.2.1.r%s.g%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
  fi
}

build() {
  cd "$pkgname"
  cargo build --locked --release --workspace
}

check() {
  cd "$pkgname"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/wreathd "$pkgdir/usr/bin/wreathd"
  install -Dm755 target/release/wreathctl "$pkgdir/usr/bin/wreathctl"
  install -Dm755 target/release/wreath-ui "$pkgdir/usr/bin/wreath-ui"

  install -Dm644 packaging/wreathd.service \
    "$pkgdir/usr/lib/systemd/user/wreathd.service"
  install -Dm644 packaging/io.github.mika2go.Wreath.desktop \
    "$pkgdir/usr/share/applications/io.github.mika2go.Wreath.desktop"
  install -Dm644 packaging/io.github.mika2go.Wreath.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.mika2go.Wreath.metainfo.xml"
  install -Dm644 packaging/io.github.mika2go.Wreath.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.mika2go.Wreath.svg"
  install -Dm644 packaging/io.github.mika2go.Wreath-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.mika2go.Wreath-symbolic.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/install.md "$pkgdir/usr/share/doc/$pkgname/install.md"
}
