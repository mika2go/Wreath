pkgname=trace-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Lightweight local-first instant replay recorder for Hyprland"
arch=('x86_64')
url="https://github.com/mika2go/trace"
license=('MIT')
depends=('gpu-screen-recorder' 'gtk4' 'hyprland')
makedepends=('cargo' 'git')
provides=('trace')
conflicts=('trace')
source=("$pkgname::git+$url.git")
b2sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags 2>/dev/null \
    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$pkgname"
  cargo build --locked --release --workspace
}

check() {
  cd "$pkgname"
  cargo test --locked --workspace
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/traced "$pkgdir/usr/bin/traced"
  install -Dm755 target/release/tracectl "$pkgdir/usr/bin/tracectl"
  install -Dm755 target/release/trace-ui "$pkgdir/usr/bin/trace-ui"

  install -Dm644 packaging/traced.service \
    "$pkgdir/usr/lib/systemd/user/traced.service"
  install -Dm644 packaging/io.github.mika2go.Trace.desktop \
    "$pkgdir/usr/share/applications/io.github.mika2go.Trace.desktop"
  install -Dm644 packaging/io.github.mika2go.Trace.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.mika2go.Trace.metainfo.xml"
  install -Dm644 packaging/io.github.mika2go.Trace.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.mika2go.Trace.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
