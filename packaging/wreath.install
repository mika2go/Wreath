post_install() {
  printf '%s\n' \
    'Wreath installed.' \
    'Enable the recorder with: systemctl --user reenable --now wreathd.service' \
    'Hyprland shortcuts are registered automatically.' \
    'On KDE Plasma, assign your preferred shortcut to: wreathctl save' \
    'Run `wreathctl doctor` to verify capture, GPU, audio, and desktop integration.'
}

post_upgrade() {
  post_install
}
