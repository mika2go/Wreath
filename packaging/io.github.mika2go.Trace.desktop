[Desktop Entry]
Type=Application
Name=Trace
GenericName=Game Clip Recorder
Comment=Capture and watch local instant replays
Exec=trace-ui
TryExec=trace-ui
Icon=io.github.mika2go.Trace
Terminal=false
Categories=AudioVideo;Recorder;
Keywords=trace;replay;recording;clip;video;hyprland;kde;plasma;
StartupNotify=true
StartupWMClass=io.github.mika2go.Trace
Actions=SaveClip;

[Desktop Action SaveClip]
Name=Save replay now
Exec=tracectl save
